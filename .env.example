# Copy to .env, fill secrets locally, and never commit the result.
CENTERSEAT_ENV=production
CENTERSEAT_PROVIDER_MODE=opencinema
CENTERSEAT_HTTP_ADDR=:8080
CENTERSEAT_API_URL=http://localhost:8080
# Agent JSON routes (/api/agent/*) and MCP (/api/mcp) stay disabled (404) until
# this bearer token is set. Use a long random value; never put it in URLs.
CENTERSEAT_AGENT_TOKEN=
# Public origin used in shareable search links, e.g. https://movies.angl.gg.
# Defaults to the request origin.
CENTERSEAT_PUBLIC_URL=
# Maximum cold-start wait for the optional homepage marquee. Warm and stale
# cache hits return immediately.
CENTERSEAT_TRENDING_TIMEOUT_MS=4000


# Free-text location resolution uses Nominatim by default. Set URL=off to disable.
CENTERSEAT_GEOCODER_URL=
# Supply a descriptive app/contact User-Agent when changing the endpoint.
CENTERSEAT_GEOCODER_USER_AGENT=
# Comma-separated Nominatim country codes (default: us).
CENTERSEAT_GEOCODER_COUNTRIES=
# Open Cinema is self-service and supplies live indie/repertory showtimes and
# provider checkout links. It does not supply per-seat inventory.
OPEN_CINEMA_API_BASE_URL=https://opencinema.app
OPEN_CINEMA_API_KEY=

# Optional future full-inventory path. Atom requires partner approval.
ATOM_API_BASE_URL=https://api.atomtickets.com
ATOM_API_KEY=
ATOM_PARTNER_ID=

# Personal, local-only full seat-inventory path. To opt in, set
# CENTERSEAT_ENV=local and CENTERSEAT_PROVIDER_MODE=fandango-local. The adapter
# has a strict GET allowlist and cannot run reservation or checkout calls.
FANDANGO_BASE_URL=https://www.fandango.com
FANDANGO_MINIMUM_DELAY_MS=50
FANDANGO_MAX_CONCURRENCY=8
