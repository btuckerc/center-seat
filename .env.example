# Copy to .env, fill secrets locally, and never commit the result.
CENTERSEAT_ENV=production
CENTERSEAT_PROVIDER_MODE=vista
CENTERSEAT_HTTP_ADDR=:8080
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgres://centerseat:replace-with-a-long-random-value@localhost:5432/centerseat?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CENTERSEAT_API_URL=http://localhost:8080

# Licensed Vista Digital Platform / OCAPI integration. Server-side only.
VISTA_API_BASE_URL=https://your-api-host/ocapi/v1
VISTA_AUTH_URL=https://your-gas-host/connect/token
VISTA_CLIENT_ID=
VISTA_USERNAME=
VISTA_PASSWORD=
VISTA_REGION_CODE=
VISTA_SITE_IDS=
# Optional. Example tokens: {showtime_id}, {site_id}.
VISTA_BOOKING_URL_TEMPLATE=
