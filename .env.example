# The local project runs with the deterministic provider by default.
CENTERSEAT_PROVIDER_MODE=demo
CENTERSEAT_HTTP_ADDR=:8080
DATABASE_URL=postgres://centerseat:centerseat@localhost:5432/centerseat?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Configure licensed integrations in production. Never expose these to the web bundle.
SHOWTIME_PROVIDER=gracenote
SHOWTIME_PROVIDER_BASE_URL=
SHOWTIME_PROVIDER_API_KEY=
INVENTORY_PROVIDER=vista
INVENTORY_PROVIDER_BASE_URL=
INVENTORY_PROVIDER_CLIENT_ID=
INVENTORY_PROVIDER_CLIENT_SECRET=
